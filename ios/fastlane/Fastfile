default_platform(:ios)

platform :ios do
  desc "Build Scarlet Talk and push to TestFlight"
  lane :beta do
    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER"],
      key_content: ENV["ASC_KEY_PEM"],   # raw .p8 PEM contents
      in_house: false
    )

    # Make sure the app record + bundle id exist (idempotent).
    begin
      produce(
        app_identifier: "com.idoschoenberg.scarlettalk",
        app_name: "Scarlet Talk",
        language: "English",
        sku: "scarlettalk",
        api_key: key
      )
    rescue => e
      UI.message("produce skipped (app likely exists): #{e}")
    end

    build_app(
      project: "ScarletTalk.xcodeproj",
      scheme: "ScarletTalk",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["DEVELOPMENT_TEAM"]
      }
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
