default_platform(:ios)

platform :ios do
  desc "Build Scarlet Talk and push to TestFlight"
  lane :beta do
    # CI keychain — cloud-managed signing needs somewhere to store the cert key.
    setup_ci

    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER"],
      key_content: ENV["ASC_KEY_PEM"],   # raw .p8 PEM contents
      in_house: false
    )

    # NOTE: the App Store Connect *app record* must exist (one-time manual step
    # in the ASC website) — `produce` can't create it with an API key.

    auth = "-authenticationKeyPath #{ENV['ASC_P8_PATH']} " \
           "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
           "-authenticationKeyIssuerID #{ENV['ASC_ISSUER']}"

    build_app(
      project: "ScarletTalk.xcodeproj",
      scheme: "ScarletTalk",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates #{auth} DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']}",
      export_xcargs: "-allowProvisioningUpdates #{auth}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["DEVELOPMENT_TEAM"]
      }
    )

    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
