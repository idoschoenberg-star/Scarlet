default_platform(:ios)

BUNDLE_ID = "com.idoschoenberg.scarlettalk"
PROFILE_NAME = "ScarletTalk AppStore"
# The embedded (but independently runnable) watch app signs with its own
# App ID + profile; team.js ensures the bundle id exists and clears stale
# profiles before this lane runs.
WATCH_BUNDLE_ID = "com.idoschoenberg.scarlettalk.watchkitapp"
WATCH_PROFILE_NAME = "ScarletWatch AppStore"

platform :ios do
  desc "Build Scarlet Talk (+ watch app) and push to TestFlight"
  lane :beta do
    # CI keychain — the distribution cert's private key lives here for the run.
    setup_ci

    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER"],
      key_content: ENV["ASC_KEY_PEM"],   # raw .p8 PEM contents
      in_house: false
    )

    # BOTH targets declare the HealthKit entitlement (phone reads/launches the
    # watch session; watch runs HKWorkoutSession) — BOTH App IDs must carry the
    # capability or archiving fails entitlement matching. Build 258 failed
    # exactly here: the phone App ID already had HealthKit so a phone-only
    # check no-opped, while the watch App ID had none and its profile came
    # back without the entitlement. Idempotent: an already-enabled capability
    # is left alone; sigh's force:true below then regenerates the profiles to
    # include it. This must FAIL the run when it can't do its job — a
    # swallowed error here just moves the failure to the archive step with a
    # confusing profile message.
    begin
      # Spaceship needs a real token, not app_store_connect_api_key's hash.
      Spaceship::ConnectAPI.auth(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER"],
        filepath: ENV["ASC_P8_PATH"]
      )
      [BUNDLE_ID, WATCH_BUNDLE_ID].each do |bid|
        bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: bid })
                                                .find { |b| b.identifier == bid }
        UI.user_error!("App ID #{bid} not found on the developer portal") unless bundle
        has_hk = bundle.get_capabilities.any? { |c| c.capability_type == "HEALTHKIT" }
        if has_hk
          UI.message("HealthKit capability already on #{bid}")
        else
          if bundle.respond_to?(:create_capability)
            bundle.create_capability("HEALTHKIT")
          else
            Spaceship::ConnectAPI::BundleIdCapability.create(
              bundle_id_id: bundle.id, capability_type: "HEALTHKIT"
            )
          end
          UI.message("Enabled HealthKit capability on #{bid}")
        end
      end
    rescue => e
      UI.user_error!("HealthKit capability setup failed: #{e.message}")
    end

    # Manual distribution signing, minted fresh each run via the ASC API.
    # (team.js already revoked stale certs whose keys died with old runners.)
    get_certificates(
      api_key: key,
      development: false,
      keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
      keychain_password: ""
    )

    get_provisioning_profile(
      api_key: key,
      app_identifier: BUNDLE_ID,
      provisioning_name: PROFILE_NAME,
      ignore_profiles_with_different_name: true,
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME] || PROFILE_NAME

    get_provisioning_profile(
      api_key: key,
      app_identifier: WATCH_BUNDLE_ID,
      provisioning_name: WATCH_PROFILE_NAME,
      ignore_profiles_with_different_name: true,
      force: true
    )
    watch_profile_name = lane_context[SharedValues::SIGH_NAME] || WATCH_PROFILE_NAME

    # The archive signs each target by the PROVISIONING_PROFILE_SPECIFIER in
    # project.yml — canonical names only. team.js deletes stale same-named
    # profiles every run precisely so sigh can recreate these exact names; if
    # a rename still slipped through, fail HERE with the real story instead of
    # a cryptic codesign error mid-archive.
    if profile_name != PROFILE_NAME || watch_profile_name != WATCH_PROFILE_NAME
      UI.user_error!("Provisioning profile name drifted (got '#{profile_name}' / " \
                     "'#{watch_profile_name}') — stale profiles squatting on the canonical " \
                     "names; team.js cleanup should have removed them. Re-run the workflow.")
    end

    build_app(
      project: "ScarletTalk.xcodeproj",
      scheme: "ScarletTalk",
      export_method: "app-store",
      # NOTE: no global PROVISIONING_PROFILE_SPECIFIER here — phone and watch
      # targets each carry their own in project.yml, and a global xcarg would
      # stamp the phone profile onto the watch target and fail its codesign.
      xcargs: "DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']} " \
              "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '2')} CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["DEVELOPMENT_TEAM"],
        provisioningProfiles: {
          BUNDLE_ID => profile_name,
          WATCH_BUNDLE_ID => watch_profile_name
        }
      }
    )

    # Fire-and-forget upload: don't block CI on Apple's (currently slow)
    # processing — the binary is delivered the moment this returns, and Apple
    # processes it into TestFlight on its own schedule.
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
